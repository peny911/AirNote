# AirNote Server Configuration
PORT=3100
HOST=127.0.0.1
NODE_ENV=development

# SQLite database file path & isolated uploads directory
DB_PATH=./data/airnote.db
UPLOADS_DIR=./data/uploads

# 32-byte hex key (64 hex characters) for AES-256-GCM encryption of TOTP secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If omitted in development, AirNote auto-generates and persists data/.master.key
MASTER_KEY=

# Session cookie settings
SESSION_TTL_DAYS=14
COOKIE_SECURE=auto
TRUST_PROXY=false
